{
    "name": "innoboxrr/laravel-notifications",
    "description": "Facilita el API de Notificaciones de Laravel",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LaravelNotifications\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "innoboxrr/larapack-generator": "^7.0"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LaravelNotifications\\Providers\\AppServiceProvider",
                "Innoboxrr\\LaravelNotifications\\Providers\\AuthServiceProvider",
                "Innoboxrr\\LaravelNotifications\\Providers\\EventServiceProvider",
                "Innoboxrr\\LaravelNotifications\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LaravelNotifications\\Tests\\": "tests/"
        }
    }
}
